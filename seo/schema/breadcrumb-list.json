{
  "_template": "BreadcrumbList — every page. Hebrew labels.",
  "_inputs": ["ordered crumbs: [{name_he, url}]"],
  "json": {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "דף הבית", "item": "https://il-tools.co.il/" },
      { "@type": "ListItem", "position": 2, "name": "{{hub_name_he}}", "item": "https://il-tools.co.il{{hub_path}}" },
      { "@type": "ListItem", "position": 3, "name": "{{page_title}}", "item": "https://il-tools.co.il{{page_path}}" }
    ]
  },
  "_notes": [
    "The last item may omit `item` (current page).",
    "Breadcrumb labels must match the visible Hebrew breadcrumb trail."
  ]
}
