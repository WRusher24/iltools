# IL-Tools — environment variables. EVERYTHING is optional: with no variables the site builds and runs from static files.
# Copy to .env.local for local work. Never commit real values. Details: docs/engineering/ENV_VARS.md

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://il-tools.co.il
# Set to 1 on staging/preview to force noindex + robots Disallow (Vercel preview deployments are noindex automatically)
NEXT_PUBLIC_FORCE_NOINDEX=

# --- Ads (AdSense) — owner supplies after Google approval ---
NEXT_PUBLIC_ADSENSE_CLIENT=            # ca-pub-0000000000000000
ADSENSE_PUBLISHER_ID=                  # pub-0000000000000000 (for /ads.txt)
NEXT_PUBLIC_ADSENSE_SLOT_AD_1=         # numeric slot ids, one per AD-1..AD-5
NEXT_PUBLIC_ADSENSE_SLOT_AD_2=
NEXT_PUBLIC_ADSENSE_SLOT_AD_3=
NEXT_PUBLIC_ADSENSE_SLOT_AD_4=
NEXT_PUBLIC_ADSENSE_SLOT_AD_5=

# --- Analytics (consent-gated) ---
NEXT_PUBLIC_GA_ID=                     # G-XXXXXXXXXX

# --- Database (Neon primary; Supabase works with the same variable) ---
DATABASE_URL=                          # postgres://user:pass@host/db?sslmode=require  (use the POOLED url on Neon)
ENCRYPTION_KEY=                        # REQUIRED when DATABASE_URL is set: openssl rand -base64 32
HASH_SALT_SECRET=                      # openssl rand -hex 24 (rotating-salt secret for ip/ua hashes)
LEAD_RETENTION_DAYS=                   # set after the owner/attorney decides the retention period (privacy policy §9)

# --- Email (double opt-in + lead confirmations) ---
RESEND_API_KEY=
EMAIL_FROM=                            # "IL-Tools <no-reply@your-domain>"  (verified sender)

# --- Abuse protection (optional) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
TURNSTILE_SECRET_KEY=                  # server side; add the site key to the forms when enabling
CRON_SECRET=                           # >=16 chars; Vercel sends it as Bearer token to /api/cron/*
ADMIN_DELETE_TOKEN=                    # >=16 chars; authorises DELETE /api/leads/:id
