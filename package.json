{
  "name": "il-tools",
  "version": "1.0.0",
  "private": true,
  "description": "IL-Tools — Hebrew RTL comparison and calculator platform (il-tools.co.il)",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/prebuild.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node scripts/lint-logical-css.mjs",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "content:validate": "node scripts/content-qa.mjs",
    "content:tokens": "tsx scripts/validate-tokens.ts",
    "legal:extract": "node scripts/extract-legal.mjs",
    "legal:lint": "node scripts/legal-lint.mjs",
    "seo:lint": "node scripts/seo-lint.mjs",
    "rates:check": "node scripts/rates-check.mjs",
    "affiliate:check": "node scripts/check-affiliate-links.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts",
    "lhci": "lhci autorun"
  },
  "dependencies": {
    "fuse.js": "^7.5.0",
    "gray-matter": "^4.0.3",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "next": "16.4.2",
    "postgres": "^3.4.9",
    "drizzle-orm": "^0.45.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.2",
    "fast-check": "^4.0.0",
    "postcss": "^8.5.0",
    "prettier": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5",
    "@fontsource/heebo": "^5.2.0",
    "@fontsource/assistant": "^5.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  }
}