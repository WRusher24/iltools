{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm exec next start -p 3200",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://localhost:3200/",
        "http://localhost:3200/compare/green-invoice-vs-morning",
        "http://localhost:3200/calculators/vat",
        "http://localhost:3200/guides/setup/open-osek-patur",
        "http://localhost:3200/legal/privacy"
      ],
      "numberOfRuns": 1,
      "settings": { "preset": "desktop", "chromeFlags": "--no-sandbox" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.85 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }]
      }
    }
  }
}
